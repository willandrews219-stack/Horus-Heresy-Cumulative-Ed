    <selectionEntry type="upgrade" import="true" name="Mine Plough" hidden="false" id="43a1-bd4d-f81c-169e" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="false" id="4aa5-a68d-1a5a-a679" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <rules>
        <rule name="Mine Plough" id="ec1e-9769-e2a6-3987" hidden="false">
          <description>A vehicle equipped with a mine plough rolls 2D6 when making a Dangerous Terrain test instead of just one dice. The test is only failed if the result of both rolls is 1s. In addition, whenever the vehicle moves through an enemy Infantry unit as part of a Tank Shock move and is not destroyed, the enemy unit takes D3+1 S2 AP- hits.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="10"/>
      </costs>
    </selectionEntry>
